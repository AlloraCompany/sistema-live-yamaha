{
  "name": "@lle/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker-main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'test/concurrency/**'",
    "test:concurrency": "vitest run test/concurrency",
    "test:load": "tsx test/load/live-load.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "seed:catalog": "tsx --env-file-if-exists=../../.env scripts/seed-catalog.ts",
    "ensaio:limpar": "tsx --env-file-if-exists=../../.env scripts/clear-rehearsal.ts",
    "motos:modelo": "tsx scripts/motos.ts modelo",
    "motos:importar": "tsx --env-file-if-exists=../../.env scripts/motos.ts importar"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "8.3.0",
    "@lle/shared": "1.0.0",
    "fastify": "5.12.7",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
