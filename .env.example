# =============================================================================
# Live Limpa Estoque Yamaha — variáveis de ambiente
# Copie para .env e preencha. Em produção, use o cofre de segredos do provedor.
# =============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# URL pública (https). Usada no notification_url do Mercado Pago e nos webhooks.
PUBLIC_BASE_URL=https://live.seudominio.com.br
# Pasta com o build da loja (apps/web/dist) para a API servir junto. Vazio = servir por CDN/Nginx.
WEB_DIST_DIR=../web/dist

# --- Banco (PostgreSQL 15+; recomendado gerenciado: RDS, Cloud SQL, Neon, Supabase) ---
DATABASE_URL=postgres://usuario:senha@host:5432/lle
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# --- Rede / segurança ---
# Quantos proxies à frente da API são confiáveis (load balancer = 1; CDN + LB = 2).
TRUST_PROXY=1
SESSION_TTL_HOURS=12
# Senha única do painel (/painel). Obrigatória em produção: 12+ caracteres, com letras e números.
# Trocar a senha (e reiniciar a API) desconecta todas as sessões abertas com a senha antiga.
ADMIN_PASSWORD=
# Limites por IP (lembrando que muita gente no 4G compartilha IP).
ORDER_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=600
MAX_SSE_CLIENTS=20000
# true = a própria API roda o worker (bom para 1 instância). Em produção com várias instâncias, rode o worker separado.
RUN_WORKER_IN_PROCESS=false
# Tolerância após o fim da reserva antes de devolver a moto ao estoque (cobre atraso de webhook).
HOLD_GRACE_SECONDS=120

# --- Mercado Pago (Suas integrações → Credenciais de produção) ---
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...
# "Assinatura secreta" gerada ao configurar Webhooks em Suas integrações (evento: Pagamentos).
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=GERACAO YAMAHA

# --- Dados da empresa (rodapé e comprovante) ---
STORE_LEGAL_NAME=Geração Yamaha
STORE_CNPJ=
